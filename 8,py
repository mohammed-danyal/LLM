# Program 8: Simple Text Generator

import random

text = """
python is easy to learn
python is powerful and popular
machine learning uses python
machine learning is interesting
artificial intelligence uses machine learning
"""

words = text.lower().split()

model = {}

# Build Markov model
for i in range(len(words) - 1):

    current = words[i]
    next_word = words[i + 1]

    if current not in model:
        model[current] = []

    model[current].append(next_word)

print("Simple Text Generation Model")
print("----------------------------")

start = input("Enter starting word: ").lower()

if start not in model:
    print("Word not found.")

else:

    generated = [start]
    current = start

    for i in range(15):

        if current not in model:
            break

        next_words = model[current]

        current = random.choice(next_words)

        generated.append(current)

    print("\nGenerated Text:")
    print(" ".join(generated))

print("\nModel Information:")
print("Number of training words:", len(words))
print("Number of learned words:", len(model))

print("\nThis is a simple demonstration")
print("of next-word text generation.")

print("Real GPT models use")
print("large neural networks and")
print("very large training datasets.")

print("\nText generation completed.")
